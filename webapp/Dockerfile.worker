FROM python:3.12.14-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /agent
COPY vendor/scraper/requirements-agent.txt vendor/scraper/constraints.txt ./
RUN pip install --no-cache-dir -r requirements-agent.txt && useradd --uid 10002 --create-home collector
COPY vendor/scraper/app ./app
WORKDIR /site
COPY cloud_job.py cloud_catalog.py retail_catalog.py ./
COPY data ./data
COPY static/products ./static/products
USER 10002:10002
ENTRYPOINT ["python", "cloud_job.py"]
CMD ["seed"]
