{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "html-scraper"
    },
    "environmentId": {
      "type": "string"
    },
    "identityId": {
      "type": "string"
    },
    "registryServer": {
      "type": "string"
    },
    "apiImage": {
      "type": "string"
    },
    "apiKeySecretUrl": {
      "type": "string"
    },
    "allowedHosts": {
      "type": "string",
      "defaultValue": "example.com,www.americanas.com.br,americanas.com.br"
    },
    "chromeImage": {
      "type": "string",
      "metadata": {
        "description": "Custom image built from Dockerfile.browser and pushed to your registry"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "urlPolicy": {
      "type": "string",
      "defaultValue": "public",
      "allowedValues": [
        "public",
        "allowlist"
      ]
    },
    "mcpAllowedHosts": {
      "type": "string",
      "defaultValue": "127.0.0.1:*,localhost:*",
      "metadata": {
        "description": "Comma-separated hostnames of this MCP server, including its Azure HTTPS hostname; not scrape target domains."
      }
    },
    "mcpAllowedOrigins": {
      "type": "string",
      "defaultValue": ""
    }
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2025-01-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[parameters('identityId')]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[parameters('environmentId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8000,
            "transport": "http",
            "allowInsecure": false
          },
          "registries": [
            {
              "server": "[parameters('registryServer')]",
              "identity": "[parameters('identityId')]"
            }
          ],
          "secrets": [
            {
              "name": "scraper-api-key",
              "keyVaultUrl": "[parameters('apiKeySecretUrl')]",
              "identity": "[parameters('identityId')]"
            }
          ]
        },
        "template": {
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 1,
            "rules": [
              {
                "name": "http",
                "http": {
                  "metadata": {
                    "concurrentRequests": "1"
                  }
                }
              }
            ]
          },
          "containers": [
            {
              "name": "api",
              "image": "[parameters('apiImage')]",
              "resources": {
                "cpu": 0.5,
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "API_KEY",
                  "secretRef": "scraper-api-key"
                },
                {
                  "name": "BROWSER_URL",
                  "value": "http://localhost:8001"
                },
                {
                  "name": "BROWSER_PROXY",
                  "value": "http://localhost:8080"
                },
                {
                  "name": "ALLOWED_HOSTS",
                  "value": "[parameters('allowedHosts')]"
                },
                {
                  "name": "URL_POLICY",
                  "value": "[parameters('urlPolicy')]"
                },
                {
                  "name": "MCP_ALLOWED_HOSTS",
                  "value": "[parameters('mcpAllowedHosts')]"
                },
                {
                  "name": "MCP_ALLOWED_ORIGINS",
                  "value": "[parameters('mcpAllowedOrigins')]"
                }
              ],
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8000
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 10,
                  "failureThreshold": 60
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8000
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 10,
                  "failureThreshold": 3
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/readyz",
                    "port": 8000
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 10,
                  "failureThreshold": 3
                }
              ]
            },
            {
              "name": "chrome",
              "image": "[parameters('chromeImage')]",
              "resources": {
                "cpu": 1.25,
                "memory": "2.5Gi"
              },
              "env": [
                {
                  "name": "API_KEY",
                  "secretRef": "scraper-api-key"
                },
                {
                  "name": "BROWSER_PROXY",
                  "value": "http://localhost:8080"
                }
              ],
              "probes": [
                {
                  "type": "Startup",
                  "tcpSocket": {
                    "port": 8001
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60
                },
                {
                  "type": "Liveness",
                  "tcpSocket": {
                    "port": 8001
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 20
                }
              ]
            },
            {
              "name": "egress",
              "image": "[parameters('apiImage')]",
              "command": [
                "python",
                "-m",
                "app.egress"
              ],
              "resources": {
                "cpu": 0.25,
                "memory": "0.5Gi"
              },
              "probes": [
                {
                  "type": "Liveness",
                  "tcpSocket": {
                    "port": 8080
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 20
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "endpoint": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2025-01-01').configuration.ingress.fqdn)]"
    }
  }
}
