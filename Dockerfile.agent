FROM python:3.12.14-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements-agent.txt constraints.txt ./
RUN pip install -r requirements-agent.txt && useradd --uid 10002 --create-home researcher
COPY app/__init__.py app/policy.py app/research*.py ./app/
USER 10002:10002
ENTRYPOINT ["python", "-m", "app.research_job"]
